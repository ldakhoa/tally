#!/bin/bash
# Builds the Release version of Tally and installs it onto a paired iPhone (or named iPad/iPhone),
# keeping existing data and iCloud state.
#
#   tools/install-device                    build, install on the paired iPhone and open it
#   tools/install-device --no-open          build and install only
#   tools/install-device "Name or UDID"     install on a specific device (e.g. wife's iPhone)
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH OBJCPLUS_INCLUDE_PATH

open_after=1
wanted=""
for arg in "$@"; do
    case "$arg" in
    --no-open) open_after=0 ;;
    -h | --help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *) wanted="$arg" ;;
    esac
done

bundle_id="com.ldakhoa.tally"
built="$root/build/Build/Products/Release-iphoneos/Tally.app"
work="$(mktemp -d -t install-tally)"
trap 'rm -rf "$work"' EXIT

if ! xcrun devicectl list devices --json-output "$work/devices.json" >/dev/null 2>"$work/list.err" </dev/null; then
    tail -3 "$work/list.err" >&2
    echo "Could not list paired iOS devices." >&2
    exit 1
fi

if ! device="$(/usr/bin/python3 - "$work/devices.json" "$wanted" <<'PY'
import json, sys

wanted = sys.argv[2].strip().lower()
found = []
for entry in json.load(open(sys.argv[1])).get("result", {}).get("devices", []):
    hardware = entry.get("hardwareProperties", {})
    if hardware.get("reality") != "physical" or hardware.get("platform") != "iOS":
        continue
    found.append((hardware.get("udid", ""), entry.get("deviceProperties", {}).get("name", ""), hardware.get("deviceType", "")))

def listing(devices):
    return "\n".join(f"  {name}  ({kind}, {udid})" for udid, name, kind in devices)

if wanted:
    chosen = [d for d in found if wanted in (d[0].lower(), d[1].lower())]
    chosen = chosen or [d for d in found if wanted in d[1].lower()]
    problem = f'No paired device is named "{sys.argv[2]}".' if not chosen else f'More than one paired device matches "{sys.argv[2]}".'
else:
    chosen = [d for d in found if d[2] == "iPhone"]
    problem = "No iPhone is paired with this Mac." if not chosen else "More than one iPhone is paired with this Mac: pass the device name."
if len(chosen) != 1:
    print(problem, file=sys.stderr)
    if found:
        print("Paired devices:\n" + listing(chosen or found), file=sys.stderr)
    else:
        print("Pair the device in Xcode (Window > Devices and Simulators) first.", file=sys.stderr)
    sys.exit(1)
print(chosen[0][0] + "\t" + chosen[0][1])
PY
)"; then
    exit 1
fi

udid="${device%%$'\t'*}"
name="${device#*$'\t'}"

echo "== Release build for $name"
log="$(mktemp -t install-tally-build)"
if ! xcodebuild -project Tally.xcodeproj -scheme Tally -configuration Release \
    -destination 'generic/platform=iOS' -derivedDataPath build -allowProvisioningUpdates \
    build >"$log" 2>&1 </dev/null; then
    grep -E "error:" "$log" | sort -u | head -20
    echo "Build failed; nothing installed. Full log: $log" >&2
    exit 1
fi
rm -f "$log"

echo "== Install"
if ! xcrun devicectl device install app --device "$udid" "$built" >"$work/install.log" 2>&1 </dev/null; then
    grep -vE "^[[:space:]]*$" "$work/install.log" | tail -6 >&2
    echo "Not installed on $name. Unlock it and make sure it is connected via cable or Wi-Fi." >&2
    exit 1
fi
echo "Installed Tally on $name"

if [ "$open_after" = 1 ]; then
    xcrun devicectl device process launch --device "$udid" --terminate-existing "$bundle_id" >/dev/null 2>&1 || true
fi
